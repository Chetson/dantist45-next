# Скопируйте в .env и заполните: cp .env.example .env
# .env читают docker compose, Prisma CLI и Next.js. В git он не попадает.

# ─── PostgreSQL ───────────────────────────────────────────────────────
# На сервере обязательно задайте свой длинный пароль. Используйте только
# буквы и цифры: пароль подставляется в URL подключения.
POSTGRES_USER=dantist
POSTGRES_PASSWORD=dantist
POSTGRES_DB=dantist45
# Порт БД на этой машине (слушает только 127.0.0.1)
POSTGRES_PORT=5432

# Подключение для локальной разработки (npm run dev, prisma CLI на хосте).
# Логин, пароль, порт и имя БД должны совпадать со значениями выше.
# Контейнеры app и migrate собирают свой адрес сами (хост postgres).
DATABASE_URL="postgresql://dantist:dantist@localhost:5432/dantist45?schema=public"

# ─── Сайт в Docker ────────────────────────────────────────────────────
# Порт сайта на этой машине: http://127.0.0.1:3000
APP_PORT=3000
# 127.0.0.1 — сайт доступен только локально или через Caddy (рекомендуется).
# 0.0.0.0 — открыть порт наружу без прокси.
APP_BIND=127.0.0.1

# ─── HTTPS через Caddy (docker compose --profile proxy ...) ───────────
# Домен должен указывать A-записью на IP сервера, порты 80 и 443 открыты.
DOMAIN=dantist45.ru
