# Скопируйте в .env и при необходимости поменяйте значения.
# .env читают и docker compose, и Prisma CLI, и Next.js.

# Контейнер PostgreSQL (docker-compose.yml)
POSTGRES_USER=dantist
POSTGRES_PASSWORD=dantist
POSTGRES_DB=dantist45
POSTGRES_PORT=5432

# Подключение приложения и Prisma
DATABASE_URL="postgresql://dantist:dantist@localhost:5432/dantist45?schema=public"
